# 1. Google Gemini API Key
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. GitHub Personal Access Token (PAT)
# Get it from: https://github.com/settings/tokens (Classic token with 'repo' scope)
PAT_TOKEN=ghp_your_github_personal_access_token_here

# 3. Target Repository (owner/repo format, where .dart solutions will be pushed)
TARGET_REPO=your_username/leetcode-solutions

# 4. Git Commit Author Config (used on the target repo commits)
GIT_AUTHOR_NAME=your_github_username
GIT_AUTHOR_EMAIL=your_email@example.com
TARGET_BRANCH=main

